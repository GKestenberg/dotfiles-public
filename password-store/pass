#!/usr/bin/env bash
#
# `pass` wrapper: makes the Touch ID prompt show the file being decrypted
# plus any metadata given on the command line.
#
#   pass github              ->  Unlock password-store for ~/.password-store/github.gpg
#   pass github --name CRM   ->  Unlock password-store for ~/.password-store/github.gpg (name: CRM)
#   pass -c x --meta env=prod ->  Unlock password-store for ~/.password-store/x.gpg (env: prod)
#
# How: gpg forwards $PINENTRY_USER_DATA to gpg-agent, which hands it to the
# pinentry program's environment. Our patched pinentry-touchid (see
# pinentry/build.sh) uses it verbatim as the dialog text. `--name X` and
# `--meta k=v` (repeatable) are stripped before the real `pass` sees the
# arguments; everything else passes through untouched.
set -euo pipefail

die() { echo "pass (wrapper): $*" >&2; exit 1; }

# The real `pass`: first one in PATH that is not this script.
find_real_pass() {
  local me candidate
  me=$(readlink -f "${BASH_SOURCE[0]}")
  while IFS= read -r candidate; do
    [[ $(readlink -f "$candidate") == "$me" ]] && continue
    printf '%s\n' "$candidate"
    return 0
  done < <(type -aP pass)
  return 1
}

real_pass=$(find_real_pass) || die "real pass binary not found in PATH"

meta=()   # "key: value" strings, in the order given
args=()
while (($#)); do
  case $1 in
    --name)
      (($# >= 2)) || die "--name requires a value"
      meta+=("name: $2"); shift 2 ;;
    --name=*)
      meta+=("name: ${1#--name=}"); shift ;;
    --meta)
      (($# >= 2)) || die "--meta requires key=value"
      [[ $2 == *=* ]] || die "--meta expects key=value, got '$2'"
      meta+=("${2%%=*}: ${2#*=}"); shift 2 ;;
    --meta=*)
      kv=${1#--meta=}
      [[ $kv == *=* ]] || die "--meta expects key=value, got '$kv'"
      meta+=("${kv%%=*}: ${kv#*=}"); shift ;;
    *)
      args+=("$1"); shift ;;
  esac
done

# Entry = first positional arg after an optional subcommand word.
entry=""
skip_subcmd=1
for a in ${args[@]+"${args[@]}"}; do
  [[ $a == -* ]] && continue
  if ((skip_subcmd)); then
    skip_subcmd=0
    case $a in
      init|ls|list|grep|find|search|show|insert|add|edit|generate|rm|remove|delete|mv|rename|cp|copy|git|help|version|otp)
        continue ;;
    esac
  fi
  entry=$a
  break
done

# Absolute path of the file being decrypted, with $HOME shown as ~.
store=${PASSWORD_STORE_DIR:-$HOME/.password-store}
if [[ -n $entry ]]; then
  location="$store/$entry.gpg"
else
  location="$store"
fi
location=${location/#$HOME/\~}

if (( ${#meta[@]} > 0 )) || [[ -z ${PINENTRY_USER_DATA:-} ]]; then
  reason="Unlock password-store for $location"
  if (( ${#meta[@]} > 0 )); then
    joined=""
    for m in "${meta[@]}"; do joined+="${joined:+, }$m"; done
    reason+=" ($joined)"
  fi
  export PINENTRY_USER_DATA="$reason"
fi

exec "$real_pass" ${args[@]+"${args[@]}"}
